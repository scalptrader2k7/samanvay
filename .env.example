SAMANVAY_STORAGE_BACKEND=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SAMANVAY_AUTH_MODE=oidc
OIDC_ISSUER=https://YOUR_AUTH_DOMAIN/
OIDC_AUDIENCE=YOUR_API_AUDIENCE
OIDC_JWKS_URL=https://YOUR_AUTH_DOMAIN/.well-known/jwks.json

# Local development only; never configure demo auth in Vercel.
SAMANVAY_LOCAL_STORAGE_DIR=.local/samanvay-service
SAMANVAY_DEMO_TOKEN=replace-with-a-long-local-token
SAMANVAY_DEMO_SUBJECT=local-demo-owner
