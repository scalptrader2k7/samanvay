  "components": {
    "schemas": {
      "DecisionRequest": {
        "properties": {
          "action": {
            "type": "string",
            "pattern": "^(approve|reject|defer)$",
            "title": "Action"
          },
          "relationship_type": {
            "type": "string",
            "pattern": "^(identity|functional_equivalence)$",
            "title": "Relationship Type"
          },
          "member_ids": {
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 2,
            "title": "Member Ids"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 5,
            "title": "Reason"
          },
          "demonstration": {
            "type": "boolean",
            "title": "Demonstration",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "action",
          "relationship_type",
          "member_ids",
          "reason"
        ],
        "title": "DecisionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IntegrationPreviewRequest": {
        "properties": {
          "source_name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]*$",
            "title": "Source Name"
          },
          "headers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Headers"
          },
          "rows": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Rows"
          },
          "mapping": {
            "additionalProperties": true,
            "type": "object",
            "title": "Mapping"
          }
        },
        "type": "object",
        "required": [
          "source_name",
          "headers",
          "rows",
          "mapping"
        ],
        "title": "IntegrationPreviewRequest"
      },
      "Page": {
        "properties": {
          "items": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Items"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "next_offset": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "offset",
          "limit",
          "total",
          "next_offset"
        ],
        "title": "Page"
      },
      "ReconsiderRequest": {
        "properties": {
          "action": {
            "type": "string",
            "pattern": "^(approve|reject|defer)$",
            "title": "Action"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 5,
            "title": "Reason"
          },
          "demonstration": {
            "type": "boolean",
            "title": "Demonstration",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "action",
          "reason"
        ],
        "title": "ReconsiderRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkspaceRequest": {
        "properties": {
          "public_read": {
            "type": "boolean",
            "title": "Public Read",
            "default": false
          }
        },
        "type": "object",
        "title": "WorkspaceRequest"
      }
    }
  }
